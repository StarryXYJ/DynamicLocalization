<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="[12.1.4,13.0.0)"/>
        <PackageReference Include="Avalonia.Desktop" Version="[12.1.4,13.0.0)"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.1.4,13.0.0)"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="[12.1.4,13.0.0)"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.0.0,9.0.0)"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[6.0.0,10.0.0)"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\DynamicLocalization.Avalonia\DynamicLocalization.Avalonia.csproj" />
      <ProjectReference Include="..\..\src\DynamicLocalization.DependencyInjection\DynamicLocalization.DependencyInjection.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Localization\*.json" />
    </ItemGroup>
</Project>
